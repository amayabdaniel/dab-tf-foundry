# Terraform / Terragrunt
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored — it records the exact
# provider versions and their signed checksums, so it is Terraform's
# equivalent of package-lock.json / go.sum / Cargo.lock. Committing it is
# what makes `terraform init` reproducible and integrity-checked; ignoring
# it lets init resolve a different provider build (or, worse, a swapped
# one at the same version) with nothing to verify.
.terragrunt-cache/
backend.tf
provider.tf
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
*.zip
